
<odoo>
  <template id="kardex_costeado_pdf_template">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
          <t t-set="company" t-value="o.company_id"/>
          <div class="page">
            <h2 style="margin:0 0 8px 0;">Kardex Costeado</h2>
            <p style="margin:0 0 12px 0;font-size:12px;">
              Período: <t t-esc="data.get('date_from')"/> - <t t-esc="data.get('date_to')"/>
            </p>

            <t t-set="kardex" t-value="data.get('kardex_data') or {}"/>
            <t t-foreach="kardex.values()" t-as="prod">
              <h3 style="margin:12px 0 6px 0;">
                Producto: <t t-esc="prod.get('product_display_name')"/>
              </h3>

              <p style="font-size:12px;margin:0 0 6px 0;">
                <b>Existencia anterior:</b>
                <t t-esc="formatLang(prod.get('opening_qty') or 0.0)"/> &#160; — &#160;
                <b>Valor:</b> <t t-esc="formatLang(prod.get('opening_value') or 0.0, currency_obj=company.currency_id)"/> &#160; — &#160;
                <b>Costo (Unit):</b> <t t-esc="formatLang(prod.get('opening_unit_cost') or 0.0, currency_obj=company.currency_id)"/>
              </p>

              <table class="table table-sm o_main_table" style="width:100%;font-size:11px;">
                <thead>
                  <tr>
                    <th>Fecha</th>
                    <th>Documento</th>
                    <th>Origen</th>
                    <th>Destino</th>
                    <th style="text-align:right;">Exist. Ant. (Qty)</th>
                    <th style="text-align:right;">Exist. Ant. (Valor)</th>
                    <th style="text-align:right;">Entradas (Qty)</th>
                    <th style="text-align:right;">Entradas (Valor)</th>
                    <th style="text-align:right;">Salidas (Qty)</th>
                    <th style="text-align:right;">Salidas (Valor)</th>
                    <th style="text-align:right;">Exist. Actual (Qty)</th>
                    <th style="text-align:right;">Exist. Actual (Valor)</th>
                    <th style="text-align:right;">Costo actual (Unit)</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-foreach="prod.get('lines')" t-as="ln">
                    <tr>
                      <td><t t-esc="format_date(ln.get('date'))"/></td>
                      <td><t t-esc="ln.get('move_name') or ln.get('picking_name')"/></td>
                      <td><t t-esc="ln.get('src')"/></td>
                      <td><t t-esc="ln.get('dst')"/></td>
                      <td style="text-align:right;"><t t-esc="formatLang(ln.get('exist_prev_qty') or 0.0)"/></td>
                      <td style="text-align:right;"><t t-esc="formatLang(ln.get('exist_prev_val') or 0.0, currency_obj=company.currency_id)"/></td>
                      <td style="text-align:right;"><t t-esc="formatLang(ln.get('in_qty') or 0.0)"/></td>
                      <td style="text-align:right;"><t t-esc="formatLang(ln.get('in_val') or 0.0, currency_obj=company.currency_id)"/></td>
                      <td style="text-align:right;"><t t-esc="formatLang(ln.get('out_qty') or 0.0)"/></td>
                      <td style="text-align:right;"><t t-esc="formatLang(ln.get('out_val') or 0.0, currency_obj=company.currency_id)"/></td>
                      <td style="text-align:right;"><t t-esc="formatLang(ln.get('exist_now_qty') or 0.0)"/></td>
                      <td style="text-align:right;"><t t-esc="formatLang(ln.get('exist_now_val') or 0.0, currency_obj=company.currency_id)"/></td>
                      <td style="text-align:right;"><t t-esc="formatLang(ln.get('unit_cost_now') or 0.0, currency_obj=company.currency_id)"/></td>
                    </tr>
                  </t>
                </tbody>
              <!-- MRC: Marcador para ajustes de costo (SVL quantity=0, value!=0) -->
<t t-foreach="lines" t-as="line">
    <t t-if="getattr(line, 'is_cost_adjustment', False)">
        <tr>
            <td><t t-esc="line.date or ''"/></td>
            <td>Ajuste de costo</td>
            <td><t t-esc="line.document or ''"/></td>
            <td><t t-esc="line.location or ''"/></td>
            <td class="text-end">0.0000</td>
            <td class="text-end">0.00</td>
            <td class="text-end">0.0000</td>
            <td class="text-end"><t t-esc="formatLang(line.adjust_value, currency_obj=currency)"/></td>
            <td class="text-end">0.0000</td>
            <td class="text-end"><t t-esc="formatLang(line.balance_value, currency_obj=currency)"/></td>
            <td class="text-end"><t t-esc="line.cost_unit_str or ''"/></td>
        </tr>
    </t>
</t>
</table>

              <p style="font-size:12px;margin:8px 0 18px 0;">
                <b>Total Entradas:</b> 
                <t t-esc="formatLang(prod.get('in_qty') or 0.0)"/> (Valor: 
                <t t-esc="formatLang(prod.get('in_val') or 0.0, currency_obj=company.currency_id)"/>)
                &#160; — &#160;
                <b>Total Salidas:</b> 
                <t t-esc="formatLang(prod.get('out_qty') or 0.0)"/> (Valor: 
                <t t-esc="formatLang(prod.get('out_val') or 0.0, currency_obj=company.currency_id)"/>)
                &#160; — &#160;
                <b>Saldo Final:</b> 
                <t t-esc="formatLang(prod.get('running_qty') or 0.0)"/> (Valor: 
                <t t-esc="formatLang(prod.get('running_val') or 0.0, currency_obj=company.currency_id)"/>)
              </p>
            </t>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>
