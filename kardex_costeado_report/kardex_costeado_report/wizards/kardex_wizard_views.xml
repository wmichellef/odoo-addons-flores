<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kardex_costeado_wizard_form" model="ir.ui.view">
        <field name="name">kardex.costeado.wizard.form</field>
        <field name="model">kardex.costeado.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Movimiento de Kardex Costeado">
                <group>
                    <field name="date_from" required="1"/>
                    <field name="date_to" required="1"/>
                    <field name="product_category_id"/>
                    <field name="product_ids" widget="many2many_tags" domain="[('type', '=', 'product')]"/>
        <field name="location_id"/>
                </group>
                <footer>
    <button name="generate_excel_report" string="Exportar Excel" type="object" class="btn-secondary"/>
                    <button name="action_generate_report" type="object" string="Generar Reporte" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kardex_costeado_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de Movimiento de Kardex Costeado</field>
        <field name="res_model">kardex.costeado.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Custom parent menu -->
    <menuitem id="menu_kardex_reports_root" name="Kardex Reports" parent="stock.menu_stock_root" sequence="5"/>
    <menuitem id="menu_kardex_costeado_report" name="Kardex Costeado" parent="kardex_costeado_report.menu_kardex_reports_root" action="action_kardex_costeado_wizard" sequence="10"/>
</odoo>