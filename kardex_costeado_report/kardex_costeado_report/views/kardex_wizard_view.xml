<odoo>
    <record id="view_kardex_costeado_wizard" model="ir.ui.view">
        <field name="name">kardex.costeado.wizard.form</field>
        <field name="model">kardex.costeado.wizard</field>
        <field name="arch" type="xml">
            <form string="Kardex Costeado">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="product_category_id"/>
                    <field name="product_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_generate_report" type="object" string="Generar PDF" class="btn-primary"/>
                    <button name="generate_excel_report" type="object" string="Generar Excel"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kardex_costeado_wizard" model="ir.actions.act_window">
        <field name="name">Kardex Costeado</field>
        <field name="res_model">kardex.costeado.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_kardex_costeado_root" name="Reportes Inventario" parent="stock.menu_stock_warehouse_mgmt"/>
    <menuitem id="menu_kardex_costeado_report" name="Kardex Costeado" parent="menu_kardex_costeado_root" action="action_kardex_costeado_wizard"/>
</odoo>