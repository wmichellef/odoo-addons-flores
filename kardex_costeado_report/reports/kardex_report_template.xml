<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="kardex_costeado_report_template" name="Kardex Costeado Report">
    <t t-call="web.html_container">
      <t t-call="web.external_layout">
        <div class="page" style="margin-top:-45px;">

          <!-- TÍTULO CENTRADO -->
          <h2 style="margin:0 0 8px 0; text-align:center;">Kardex Costeado Report</h2>

          <!-- PERÍODO CENTRADO -->
          <p style="margin:0 0 12px 0; font-size:15px; text-align:center;">
            Período:
            <span t-esc="date_from or 'N/A'"/> -
            <span t-esc="date_to or 'N/A'"/>
          </p>

          <t t-if="kardex_data">
            <t t-foreach="kardex_data.values()" t-as="product_data">

              <!-- PRODUCTO CON TAMAÑO DE FUENTE 15PX -->
              <h3 style="margin:12px 0 6px 0; font-size:15px; font-weight:bold;">
                Producto:
                <span t-esc="product_data.get('product_name') or product_data.get('product') or ''"/>
              </h3>

              <!-- Totales acumulados por producto -->
              <t t-set="total_in_qty" t-value="0.0"/>
              <t t-set="total_in_value" t-value="0.0"/>
              <t t-set="total_out_qty" t-value="0.0"/>
              <t t-set="total_out_value" t-value="0.0"/>
              <t t-set="total_transfer_qty" t-value="0.0"/>

              <!-- Saldo final efectivo (último no-interno) -->
              <t t-set="final_qty_eff" t-value="0.0"/>
              <t t-set="final_value_eff" t-value="0.0"/>

              <!-- Encadenado de “Existencia Anterior” mostrada -->
              <t t-set="first_row" t-value="True"/>
              <t t-set="disp_prev_qty" t-value="0.0"/>
              <t t-set="disp_prev_value" t-value="0.0"/>

              <table class="table table-sm" style="width:100%;border-collapse:collapse;font-size:11px;">
                <thead>
                  <tr>
                    <th style="border-bottom:2px solid black;text-align:left;">Fecha</th>
                    <th style="border-bottom:2px solid black;text-align:left;">Tipo</th>
                    <th style="border-bottom:2px solid black;text-align:left;">Documento</th>
                    <th style="border-bottom:2px solid black;text-align:left;">Bodega</th>
                    <th colspan="2" style="border-bottom:2px solid black;text-align:center;">Existencia Anterior</th>
                    <th colspan="2" style="border-bottom:2px solid black;text-align:center;">Entradas</th>
                    <th colspan="2" style="border-bottom:2px solid black;text-align:center;">Salidas</th>
                    <th style="border-bottom:2px solid black;text-align:center;">Traslado</th>
                    <th colspan="2" style="border-bottom:2px solid black;text-align:center;">Existencia Actual</th>
                    <th style="border-bottom:2px solid black;text-align:right;">Costo Actual</th>
                  </tr>
                  <tr>
                    <th colspan="4"/>
                    <th style="text-align:right;">Unidades</th>
                    <th style="text-align:right;">Valor</th>
                    <th style="text-align:right;">Unidades</th>
                    <th style="text-align:right;">Valor</th>
                    <th style="text-align:right;">Unidades</th>
                    <th style="text-align:right;">Valor</th>
                    <th style="text-align:right;">Unidades</th><!-- Traslado -->
                    <th style="text-align:right;">Unidades</th>
                    <th style="text-align:right;">Valor</th>
                    <th style="text-align:right;">(Unit)</th>
                  </tr>
                </thead>

                <tbody>
                  <t t-foreach="product_data.get('moves', [])" t-as="move">
                    <t t-set="ref" t-value="move.get('ref') or ''"/>
                    <t t-set="is_in" t-value="(move.get('type') == 'Entrada')"/>
                    <t t-set="is_out" t-value="(move.get('type') == 'Salida')"/>
                    <t t-set="is_internal" t-value="('WH/INT/' in ref) or (move.get('type') in ['Traslado','Transfer'])"/>

                    <t t-set="prev_qty_line" t-value="first_row and (move.get('previous_qty') or 0.0) or disp_prev_qty"/>
                    <t t-set="prev_val_line" t-value="first_row and (move.get('previous_value') or 0.0) or disp_prev_value"/>

                    <t t-set="in_qty_line" t-value="(not is_internal and is_in) and (move.get('qty') or 0.0) or 0.0"/>
                    <t t-set="in_val_line" t-value="((not is_internal and is_in) and (move.get('total_move') or 0.0)) or (move.get('is_cost_adjustment') and (move.get('total_move') or 0.0)) or 0.0"/>
                    <t t-set="out_qty_line" t-value="(not is_internal and is_out) and (move.get('qty') or 0.0) or 0.0"/>
                    <t t-set="out_val_line" t-value="(not is_internal and is_out) and (move.get('total_move') or 0.0) or 0.0"/>

                    <t t-set="transfer_qty_line" t-value="is_internal and (move.get('qty') or 0.0) or 0.0"/>

                    <t t-set="balance_qty_disp" t-value="prev_qty_line + in_qty_line - out_qty_line"/>
                    <t t-set="balance_value_disp" t-value="prev_val_line + in_val_line - out_val_line"/>

                    <t t-set="unit_cost_line" t-value="(balance_qty_disp and balance_value_disp / balance_qty_disp) or 0.0"/>

                    <t t-set="total_in_qty" t-value="total_in_qty + in_qty_line"/>
                    <t t-set="total_in_value" t-value="total_in_value + in_val_line"/>
                    <t t-set="total_out_qty" t-value="total_out_qty + out_qty_line"/>
                    <t t-set="total_out_value" t-value="total_out_value + out_val_line"/>
                    <t t-set="total_transfer_qty" t-value="total_transfer_qty + transfer_qty_line"/>

                    <t t-if="not is_internal">
                      <t t-set="final_qty_eff" t-value="balance_qty_disp"/>
                      <t t-set="final_value_eff" t-value="balance_value_disp"/>
                    </t>

                    <t t-set="disp_prev_qty" t-value="balance_qty_disp"/>
                    <t t-set="disp_prev_value" t-value="balance_value_disp"/>
                    <t t-set="first_row" t-value="False"/>

                    <tr>
                      <td><span t-esc="move.get('date') or ''"/></td>
                      <td><span t-esc="move.get('type') or ''"/></td>
                      <td><span t-esc="ref"/></td>
                      <td><span t-esc="move.get('warehouse') or ''"/></td>

                      <td style="text-align:right;"><span t-esc="'%.4f' % prev_qty_line"/></td>
                      <td style="text-align:right;"><span t-esc="'%.2f' % prev_val_line"/></td>
                      <td style="text-align:right;"><span t-esc="'%.4f' % in_qty_line"/></td>
                      <td style="text-align:right;"><span t-esc="'%.2f' % in_val_line"/></td>
                      <td style="text-align:right;"><span t-esc="'%.4f' % out_qty_line"/></td>
                      <td style="text-align:right;"><span t-esc="'%.2f' % out_val_line"/></td>
                      <td style="text-align:right;"><span t-esc="'%.4f' % transfer_qty_line"/></td>
                      <td style="text-align:right;"><span t-esc="'%.4f' % balance_qty_disp"/></td>
                      <td style="text-align:right;"><span t-esc="'%.2f' % balance_value_disp"/></td>
                      <td style="text-align:right;"><span t-esc="'%.4f' % (unit_cost_line or 0.0)"/></td>
                    </tr>
                  </t>
                </tbody>
              </table>

              <!-- Resumen inferior -->
              <div style="margin:8px 0 0 0;font-size:12px;">
                <p style="margin:0;">
                  <strong>Total Entradas:</strong>
                  <t t-esc="('%.2f' % total_in_qty)"/> (Valor:
                  <t t-esc="('%.2f' % total_in_value)"/>)</p>
                <p style="margin:0;">
                  <strong>Total Salidas:</strong>
                  <t t-esc="('%.2f' % total_out_qty)"/> (Valor:
                  <t t-esc="('%.2f' % total_out_value)"/>)</p>
                <p style="margin:0;">
                  <strong>Total Traslados:</strong>
                  <t t-esc="('%.2f' % total_transfer_qty)"/></p>
                <p style="margin:0;">
                  <strong>Saldo Final:</strong>
                  <t t-esc="('%.2f' % (final_qty_eff or 0.0))"/> (Valor:
                  <t t-esc="('%.2f' % (final_value_eff or 0.0))"/>)</p>
              </div>

            </t>
          </t>

          <t t-if="not kardex_data">
            <p>No hay datos de Kardex para mostrar.</p>
          </t>
        </div>
      </t>
    </t>
  </template>
</odoo>
